# ==============================
# Multitek Service MVP v0.2.0
# ==============================

# ---------- PostgreSQL ----------
POSTGRES_DB=multitek_service
POSTGRES_USER=multitek
POSTGRES_PASSWORD=GANTI_PASSWORD_DB_YANG_KUAT
DATABASE_URL=postgresql://multitek:GANTI_PASSWORD_DB_YANG_KUAT@db:5432/multitek_service

# ---------- Owner ----------
# Format nomor: 628xxxxxxxxxx (tanpa + dan tanpa 0 di depan)
OWNER_WA_NUMBER=ISI_OWNER_WA_NUMBER
OWNER_API_TOKEN=GANTI_TOKEN_OWNER_RANDOM_MIN_32_CHAR

# ---------- GOWA ----------
GOWA_BASIC_AUTH_USER=multitek
GOWA_BASIC_AUTH_PASSWORD=GANTI_PASSWORD_GOWA
GOWA_DEVICE_ID=multitek-main
GOWA_WEBHOOK_SECRET=GANTI_WEBHOOK_SECRET_RANDOM
GOWA_URL=http://gowa:3000

# ---------- AI customer service (opsional tetapi direkomendasikan) ----------
# AI hanya memahami intent/bahasa customer. Backend tetap memegang transaksi/status/harga.
AI_ENABLED=false
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=30

# ---------- Pembayaran manual ----------
PAYMENT_BANK_NAME=BCA
PAYMENT_BANK_ACCOUNT=ISI_NOMOR_REKENING_MULTITEK
PAYMENT_BANK_HOLDER="MULTITEK INDONESIA"
# Letakkan file QRIS di ./data/qris.png pada host VPS.
QRIS_IMAGE_PATH=/app/data/qris.png

# ---------- Booking murah / biaya perjalanan awal ----------
BOOKING_FEE_0_5KM=20000
BOOKING_FEE_5_10KM=30000
BOOKING_FEE_10_20KM=40000
BOOKING_FEE_20_30KM=50000
BOOKING_MANUAL_OVER_KM=30

# ---------- Matching mekanik ----------
TECHNICIAN_OFFER_TIMEOUT_SECONDS=600
TECHNICIAN_OFFER_BATCH_SIZE=3
TECHNICIAN_MIN_SKILL_LEVEL=3
TECHNICIAN_CURRENT_LOCATION_MAX_AGE_HOURS=12
MAX_MATCH_DISTANCE_KM=50

# ---------- Settlement ----------
SUCCESS_PLATFORM_PERCENT=10
FAIL_CUSTOMER_REFUND_PERCENT=60
FAIL_TECHNICIAN_PERCENT=30
FAIL_PLATFORM_PERCENT=10

# ---------- App ----------
APP_ENV=production
LOG_LEVEL=INFO
DATA_DIR=/app/data
MAX_MACHINES_PER_ORDER=20
MAX_MESSAGE_LENGTH=12000

# ---------- Hybrid AI: Gemini primary + Groq fallback ----------
AI_PRIMARY=gemini
AI_FALLBACK=groq
AI_CONFIDENCE_THRESHOLD=0.78
GEMINI_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_ENABLED=true
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
